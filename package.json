{
  "name": "@wordup-md/kies",
  "version": "0.0.0",
  "description": "Sniff a project from its files: framework, static site generator, git-based CMS, content and assets folders, workspaces. Runs in browsers and Node.js over any file system.",
  "keywords": [
    "cms",
    "decap",
    "detect",
    "framework",
    "hugo",
    "jekyll",
    "monorepo",
    "nuxt",
    "nuxt-content",
    "ssg"
  ],
  "homepage": "https://github.com/wordup-md/kies#readme",
  "bugs": {
    "url": "https://github.com/wordup-md/kies/issues"
  },
  "license": "MIT",
  "author": "ManUtopiK <emmanuel.salomon@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wordup-md/kies.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./memory": "./dist/memory.mjs",
    "./node": "./dist/node.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "release": "bumpp",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "confbox": "^0.3.2",
    "magicast": "^0.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
